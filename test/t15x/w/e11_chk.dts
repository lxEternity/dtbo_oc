	fragment@5 {
		target = <0xffffffff>;

		__overlay__ {

			gpio_keys {
				compatible = "gpio-keys";
				label = "gpio-keys";
				pinctrl-names = "default";
				pinctrl-0 = <0x36>;

				vol_down {
					label = "volume_down";
					gpios = <0x37 0x06 0x01>;
					linux,input-type = <0x01>;
					linux,code = <0x72>;
					gpio-key,wakeup;
					debounce-interval = <0x20>;
					linux,can-disable;
				};
			};
		};
	};

	fragment@6 {
		target = <0xffffffff>;

		__overlay__ {
			dummy-supply = <0x38>;
			usb-repeater = <0x38>;
		};
	};

	fragment@7 {
		target = <0xffffffff>;

		__overlay__ {
			qcom,thermal-mitigation-step = <0x7a120>;
			#cooling-cells = <0x02>;
			qcom,ship-mode-immediate;
			qcom,wireless-fw-name = "cps4061.bin";
		};
	};

	fragment@8 {
		target = <0xffffffff>;

		__overlay__ {
			interrupt-parent = <0xffffffff>;
			interrupts = <0x00 0xb6 0x01 0x03>;
			interrupt-names = "usb_wcd";
			nvmem-cells = <0x39>;
			nvmem-cell-names = "usb_mode";
			mode-switch;

			port {

				endpoint {
					remote-endpoint = <0x3a>;
					phandle = <0x3d>;
				};
			};
		};
	};

	fragment@9 {
		target = <0xffffffff>;

