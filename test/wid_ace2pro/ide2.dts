	fragment@57 {
		target = <0xffffffff>;

		__overlay__ {

			ship_sleep {
				phandle = <0x61>;

				mux {
					pins = "gpio178";
					function = "gpio";
				};

				config {
					pins = "gpio178";
					drive-strength = <0x02>;
					bias-pull-down;
					output-low;
				};
			};

			ship_active {
				phandle = <0x60>;

				mux {
					pins = "gpio178";
					function = "gpio";
				};

				config {
					pins = "gpio178";
					drive-strength = <0x02>;
					bias-pull-up;
					output-high;
				};
			};

			mcu_en_sleep {
				phandle = <0x5f>;

				mux {
					pins = "gpio67";
					function = "gpio";
				};

				config {
					pins = "gpio67";
					drive-strength = <0x02>;
					bias-pull-down;
					output-low;
				};
			};

			mcu_en_active {
				phandle = <0x5e>;

				mux {
					pins = "gpio67";
					function = "gpio";
				};

				config {
					pins = "gpio67";
					drive-strength = <0x02>;
					bias-pull-up;
					output-high;
				};
			};

			charging_inter_active {
				phandle = <0x64>;

				mux {
					pins = "gpio9";
					function = "gpio";
				};

				config {
					pins = "gpio9";
					bias-pull-up;
					drive-strength = <0x02>;
					input-enable;
				};
			};

			charging_inter_sleep {
				phandle = <0x65>;

				mux {
					pins = "gpio9";
					function = "gpio";
				};

				config {
					pins = "gpio9";
					bias-pull-up;
					drive-strength = <0x02>;
					input-enable;
				};
			};
		};
	};

	fragment@58 {
		target = <0xffffffff>;

		__overlay__ {

			usb_phy_ps {
