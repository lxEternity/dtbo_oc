	fragment@61 {
		target = <0xffffffff>;

		__overlay__ {

			oplus_ufcs_gpio {
				phandle = <0xd4>;

				ufcs_en_active {
					phandle = <0x66>;

					mux {
						pins = "gpio66";
						function = "gpio";
					};

					config {
						pins = "gpio66";
						drive-strength = <0x02>;
						bias-disable;
						output-high;
					};
				};

				ufcs_en_sleep {
					phandle = <0x67>;

					mux {
						pins = "gpio66";
						function = "gpio";
					};

					config {
						pins = "gpio66";
						drive-strength = <0x02>;
						bias-disable;
						output-low;
					};
				};

				ufcs_int_default {
					phandle = <0x68>;

					mux {
						pins = "gpio18";
						function = "gpio";
					};

					config {
						pins = "gpio18";
						drive-strength = <0x02>;
						bias-pull-up;
						input-enable;
					};
				};
			};
		};
	};

