					bias-pull-up;
				};
			};

			esim_en_gpio {
				pins = "gpio4";
				function = "normal";
				bias-disable;
				qcom,drive-strength = <0x02>;
				power-source = <0x01>;
				output-high;
				phandle = <0x95>;
			};
		};
	};

	fragment@79 {
		target = <0xffffffff>;

		__overlay__ {

			oplus_rf_cable {
				compatible = "oplus,rf_cable";
				interrupt-parent = <0xffffffff>;
				rf_cable_support_num = <0x01>;
				rf,cable0-gpio = <0xffffffff 0x3e 0x00>;
				rf,cable-support-timer = <0x00>;
				pinctrl-names = "rf_cable_active";
				pinctrl-0 = <0x94>;
			};

			oplus-gpio {
				compatible = "oplus,oplus-gpio";
				pinctrl-names = "default", "sim2_det_no_pull", "sim2_det_pull_high", "sim2_det_pull_low";
				pinctrl-0 = <0x40 0x41 0x42 0x95>;
				pinctrl-1 = <0x42>;
				pinctrl-2 = <0x43>;
				pinctrl-3 = <0x44>;
				oplus,oplus-gpio-esim = <0x45 0x04 0x00>;
				oplus,oplus-esim-det = <0x2d 0x09 0x00>;
				oplus,oplus-sim2-det = <0x46 0x05 0x00>;
				oplus,oplus-esim-en = <0xffffffff 0x3b 0x00>;
				oplus,uim-reset-pin = "modem_solution";
			};
		};
	};

