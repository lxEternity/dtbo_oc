	fragment@64 {
		target = <0xffffffff>;

		__overlay__ {

			rx_event_default {
				phandle = <0x56>;

				pins_cmd_dat {
					pinmux = <0x2100>;
					input-enable;
					bias-pull-up;
				};
			};

			rx_con_default {
				phandle = <0x57>;

				pins_cmd_dat {
					pinmux = <0x2200>;
					input-enable;
					bias-pull-down;
				};
			};

			rx_en_sleep {
				phandle = <0x58>;

				pins_cmd_dat {
					pinmux = <0x2300>;
					bias-pull-up;
					output-high;
				};
			};

			rx_en_active {
				phandle = <0x59>;

				pins_cmd_dat {
					pinmux = <0x2300>;
					bias-pull-down;
					output-low;
				};
			};

			insert_dis_active {
				phandle = <0x5a>;

				pins_cmd_dat {
					pinmux = <0x2400>;
					bias-pull-up;
					output-high;
				};
			};

			insert_dis_sleep {
				phandle = <0x5b>;

				pins_cmd_dat {
					pinmux = <0x2400>;
					bias-pull-down;
					output-low;
				};
			};
		};
	};

