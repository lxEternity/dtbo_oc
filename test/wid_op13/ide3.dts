			consumer_ir_core {
				compatible = "oplus,kookong_ir_core";
				status = "okay";
				vdd-type = <0x00>;
				vdd-supply = <0x24>;
				vdd-min-vol = <0x2ea180>;
				vdd-max-vol = <0x2ea180>;
			};
		};
	};

	fragment@84 {
		target = <0xffffffff>;

