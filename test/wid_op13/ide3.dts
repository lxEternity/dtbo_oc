		};
	};

	fragment@137 {
		target = <0xffffffff>;

		__overlay__ {
			qcom,num-macros = <0x03>;

			lpass-cdc-clk-rsc-mngr {
				clocks = <0x250 0x00 0x251 0x00 0x254 0x00 0x257 0x00>;
				clock-names = "tx_core_clk", "rx_core_clk", "rx_tx_core_clk", "va_core_clk";
			};
		};
	};

	fragment@138 {
		target = <0xffffffff>;

		__overlay__ {
			qcom,num-macros = <0x04>;

			lpass-cdc-clk-rsc-mngr {
				clocks = <0x250 0x00 0x251 0x00 0x254 0x00 0x257 0x00 0x253 0x00 0x256 0x00>;
				clock-names = "tx_core_clk", "rx_core_clk", "rx_tx_core_clk", "va_core_clk", "wsa2_core_clk", "wsa2_tx_core_clk";
			};
		};
	};

	fragment@139 {
		target = <0xffffffff>;

		__overlay__ {
			status = "ok";
		};
	};

	fragment@140 {
		target = <0xffffffff>;

		__overlay__ {

			sec_i2s1_pinctrl {
				phandle = <0x26c>;
				#gpio-cells = <0x00>;
				pinctrl-1 = <0xffffffff 0xffffffff 0xffffffff 0xffffffff>;
				pinctrl-0 = <0xffffffff 0xffffffff 0xffffffff 0xffffffff>;
				pinctrl-names = "aud_active", "aud_sleep";
				compatible = "qcom,msm-cdc-pinctrl";
				status = "ok";
			};
		};
	};

	fragment@141 {
		target = <0xffffffff>;

		__overlay__ {
			qcom,clk-freq-out = <0x61a80>;
			status = "ok";

			aw882xx_smartpa@34 {
				status = "okay";
				f0-enable = <0x01>;
				monitor-mode = "hal_monitor";
				aw-f0-default = <0x2f6>;
				aw-f0-max = <0x7d0>;
				aw-f0-min = <0x64>;
				aw-re-default = <0x16a8>;
				aw-re-max = <0x1d4c>;
				aw-re-min = <0x14b4>;
				sound-channel = <0x00>;
				sync-load = <0x01>;
				reset-gpio = <0xffffffff 0x02 0x00>;
				reg = <0x34>;
				compatible = "awinic,aw882xx_smartpa";
			};

			aw882xx_smartpa@35 {
				status = "okay";
				f0-enable = <0x01>;
				monitor-mode = "hal_monitor";
				aw-f0-default = <0x2ca>;
				aw-f0-max = <0x7d0>;
				aw-f0-min = <0x64>;
				aw-re-default = <0x17d4>;
				aw-re-max = <0x1d4c>;
				aw-re-min = <0x14b4>;
				sound-channel = <0x01>;
				sync-load = <0x01>;
				reset-gpio = <0xffffffff 0xa4 0x00>;
				reg = <0x35>;
				compatible = "awinic,aw882xx_smartpa";
			};
		};
	};

