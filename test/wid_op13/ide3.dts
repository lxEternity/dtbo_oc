	fragment@83 {
		target = <0xffffffff>;

		__overlay__ {

			sensor_fb {
				compatible = "oplus,sensor-feedback";
				master-id = <0x03>;
				smem-id = <0x260>;
				enable-trace-sensor-err = <0x01>;
				phandle = <0x115>;
			};

			ssc_interactive {
				sup-power-fb;
				report_blank_mode = <0x01>;
				receive_screenshot_info = <0x01>;
			};

			oplus_sensor {
				compatible = "oplus,sensor-devinfo";

				mag_fusion {
					sensor-type = <0x06>;
					is-virtual-sensor;
					fusion-type = <0x00>;
					fold-feature = <0x00>;
