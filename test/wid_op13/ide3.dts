					qcom,vibrator-type = <0x270f>;
					qcom,vbat-low-soc = <0x05>;
					qcom,vbat-low-soc-cold = <0x14>;
					qcom,vbat-low-temp = <0xffffffce>;
					qcom,vbat-low-fifo-vmax-mv = <0x1a2c>;
