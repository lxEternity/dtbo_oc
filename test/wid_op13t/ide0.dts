	fragment@12 {
		target = <0xffffffff>;

		__overlay__ {
			#address-cells = <0x02>;
			#size-cells = <0x00>;
			interrupt-controller;
			#interrupt-cells = <0x04>;

			qcom,pmk8550@0 {
				compatible = "qcom,spmi-pmic";
				reg = <0x00 0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				phandle = <0xeb>;

				pmic-ecid@100 {
					compatible = "qcom,pmic-ecid";
					reg = <0x100>;
					qcom,pmic-name = "pmk8550";
				};

				sdam@7000 {
					compatible = "qcom,spmi-sdam";
					reg = <0x7000>;
					#address-cells = <0x01>;
					#size-cells = <0x01>;
					phandle = <0xec>;

					sm1510_present@5d {
						reg = <0x5d 0x01>;
						bits = <0x05 0x05>;
						phandle = <0xed>;
					};

					ocp-log@76 {
						reg = <0x76 0x06>;
						phandle = <0x22>;
					};
				};

				sdam@7100 {
					compatible = "qcom,spmi-sdam";
					reg = <0x7100>;
					#address-cells = <0x01>;
					#size-cells = <0x01>;
					phandle = <0xee>;

					restart@48 {
						reg = <0x48 0x01>;
						bits = <0x01 0x07>;
						phandle = <0x1f>;
					};

					wr_thermal-flag@58 {
						reg = <0x58 0x01>;
						phandle = <0x26>;
					};

					alarm-log@76 {
						reg = <0x76 0x06>;
						phandle = <0x23>;
					};

					fmd-set@9a {
						reg = <0x9a 0x01>;
						phandle = <0xef>;
					};

					fmd-cont-after-pon@9c {
						reg = <0x9c 0x01>;
						phandle = <0xf0>;
					};

					fmd-chg-pon@9f {
						reg = <0x9f 0x01>;
						phandle = <0xf1>;
					};

					fmd-cnt2-stop@a2 {
						reg = <0xa2 0x01>;
						phandle = <0xf2>;
					};
				};

				sdam@7400 {
					compatible = "qcom,spmi-sdam";
					reg = <0x7400>;
					phandle = <0x20>;
				};

				sdam@7500 {
					compatible = "qcom,spmi-sdam";
					reg = <0x7500>;
					phandle = <0x21>;
				};

				sdam@7c00 {
					compatible = "qcom,spmi-sdam";
					reg = <0x7c00>;
					phandle = <0x12>;
				};

				sdam@7d00 {
					compatible = "qcom,spmi-sdam";
					reg = <0x7d00>;
					phandle = <0x13>;
				};

				sdam@8400 {
					compatible = "qcom,spmi-sdam";
					reg = <0x8400>;
					phandle = <0x04>;
				};

				sdam@8500 {
					compatible = "qcom,spmi-sdam";
					reg = <0x8500>;
					phandle = <0x05>;
				};

				sdam@9800 {
					compatible = "qcom,spmi-sdam";
					reg = <0x9800>;
					phandle = <0x14>;
				};

				sdam@9a00 {
					compatible = "qcom,spmi-sdam";
					reg = <0x9a00>;
					#address-cells = <0x01>;
					#size-cells = <0x01>;
					phandle = <0xf3>;

					sqm-timer@b8 {
						reg = <0xb8 0x02>;
						phandle = <0x15>;
					};
				};

				sdam@9d00 {
					compatible = "qcom,spmi-sdam";
					reg = <0x9d00>;
					phandle = <0x17>;
				};

				sdam@b600 {
					compatible = "qcom,spmi-sdam";
					reg = <0xb600>;
					phandle = <0xf4>;

					usb-mode@50 {
						reg = <0x50 0x01>;
						phandle = <0x3c>;
					};
				};

				pon_hlos@1300 {
					compatible = "qcom,pm8998-pon";
					reg = <0x1300 0x800>;
					reg-names = "pon_hlos", "pon_pbs";

					pwrkey {
						compatible = "qcom,pmk8350-pwrkey";
						interrupts = <0x00 0x13 0x07 0x03>;
						linux,code = <0x74>;
					};

					resin {
						compatible = "qcom,pmk8350-resin";
						interrupts = <0x00 0x13 0x06 0x03>;
						linux,code = <0x73>;
					};
				};

				pinctrl@b800 {
					compatible = "qcom,pmk8550-gpio";
					reg = <0xb800>;
					gpio-controller;
					#gpio-cells = <0x02>;
					interrupt-controller;
					#interrupt-cells = <0x02>;
					pinctrl-0 = <0x1c 0x1d>;
					pinctrl-names = "default";
					phandle = <0xf5>;

					alt_sleep_clk {

						alt_sleep_clk_default {
							pins = "gpio3";
							function = "func1";
							input-disable;
							output-enable;
							bias-disable;
							power-source = <0x00>;
							phandle = <0x1c>;
						};
					};

					slave_cp_therm_default {
						pins = "gpio4";
						function = "normal";
						bias-high-impedance;
						bias-disable;
						phandle = <0x1d>;
					};
				};

				rtc@6100 {
					compatible = "qcom,pmk8350-rtc";
					reg = <0x6100 0x6200>;
					reg-names = "rtc", "alarm";
					interrupts = <0x00 0x62 0x01 0x01>;
					phandle = <0xf6>;
				};

				pmk8550-pwm {
					compatible = "qcom,pmk8550-pwm";
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					#pwm-cells = <0x02>;
				};

				vadc@9000 {
					compatible = "qcom,spmi-adc5-gen3";
					reg = <0x9000 0x9100>;
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					interrupt-names = "adc-sdam0", "adc-sdam1";
					interrupts = <0x00 0x90 0x01 0x01 0x00 0x91 0x01 0x01>;
					#thermal-sensor-cells = <0x01>;
					#io-channel-cells = <0x01>;
					io-channel-ranges;
					phandle = <0x03>;

					pmk8550_offset_ref {
						reg = <0x00>;
						label = "pmk8550_offset_ref";
						qcom,pre-scaling = <0x01 0x01>;
					};

					pmk8550_vref_1p25 {
						reg = <0x01>;
						label = "pmk8550_vref_1p25";
						qcom,pre-scaling = <0x01 0x01>;
					};

					pmk8550_die_temp {
						reg = <0x03>;
						label = "pmk8550_die_temp";
						qcom,pre-scaling = <0x01 0x01>;
					};

					pm8550_offset_ref {
						reg = <0x100>;
						label = "pm8550_offset_ref";
						qcom,pre-scaling = <0x01 0x01>;
					};

					pm8550_vref_1p25 {
						reg = <0x101>;
						label = "pm8550_vref_1p25";
						qcom,pre-scaling = <0x01 0x01>;
					};

					pm8550_die_temp {
						reg = <0x103>;
						label = "pm8550_die_temp";
						qcom,pre-scaling = <0x01 0x01>;
					};

					pm8550_vph_pwr {
						reg = <0x18e>;
						label = "pm8550_vph_pwr";
						qcom,pre-scaling = <0x01 0x03>;
					};

					pm8550_skin_therm {
						reg = <0x144>;
						label = "pm8550_skin_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
						qcom,adc-tm-type = <0x01>;
					};

					pm8550_cam_flash_therm {
						reg = <0x145>;
