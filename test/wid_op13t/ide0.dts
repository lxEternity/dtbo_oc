	fragment@118 {
		target = <0xffffffff>;

		__overlay__ {

			spkr_02_sd_n {

				spkr_02_sd_n_sleep {
					phandle = <0x1f4>;

					mux {
						function = "gpio";
						pins = "gpio17";
					};

					config {
						input-enable;
						bias-pull-down;
						drive-strength = <0x02>;
						pins = "gpio17";
					};
				};

				spkr_02_sd_n_active {
					phandle = <0x1f3>;

					mux {
						function = "gpio";
						pins = "gpio17";
					};

					config {
						output-high;
						bias-disable;
						drive-strength = <0x10>;
						pins = "gpio17";
					};
				};
			};

			spkr_13_sd_n {

