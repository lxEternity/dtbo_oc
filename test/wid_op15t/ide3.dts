	fragment@1 {
		target = <0xffffffff>;

		__overlay__ {

			qcom,pmd802x@4 {
				compatible = "qcom,spmi-pmic";
				reg = <0x04 0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				pmic-ecid@100 {
					compatible = "qcom,pmic-ecid";
					reg = <0x100>;
					qcom,pmic-name = "pmd802x";
				};

				pmd802x-temp-alarm@a00 {
					compatible = "qcom,spmi-temp-alarm";
					reg = <0xa00>;
					interrupts = <0x04 0x0a 0x00 0x03>;
					#thermal-sensor-cells = <0x00>;
					phandle = <0x2f>;
				};

				pinctrl@8800 {
					compatible = "qcom,pmd802x-gpio";
					reg = <0x8800>;
					gpio-controller;
					#gpio-cells = <0x02>;
					interrupt-controller;
					#interrupt-cells = <0x02>;
					phandle = <0xcb>;

					sde_disp0_vdd_active {
						phandle = <0x19d>;
						qcom,drive-strength = <0x02>;
						power-source = <0x02>;
						bias-disable;
						output-enable;
						input-disable;
						function = "normal";
						pins = "gpio2";
					};
				};

				amoled-ecm@f900 {
					compatible = "qcom,amoled-ecm";
					reg = <0xf900>;
					interrupt-names = "ecm-sdam0", "ecm-sdam1", "ecm-sdam2";
					nvmem-names = "amoled-ecm-sdam0", "amoled-ecm-sdam1", "amoled-ecm-sdam2";
					nvmem = <0x0b 0x0c 0x0d>;
					interrupt-parent = <0xffffffff>;
					interrupts = <0x00 0xaa 0x01 0x01 0x00 0xab 0x01 0x01 0x00 0xac 0x01 0x01>;
					phandle = <0xcc>;
				};

				qcom-amoled {
					compatible = "qcom,amoled-regulator";
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					nvmem-cells = <0x0e>;
					nvmem-cell-names = "ibb_spur_sqm_timer";
					status = "disabled";
					phandle = <0xcd>;

					ibb@f800 {
						reg = <0xf800>;
						reg-names = "ibb_base";
						regulator-name = "ibb";
						regulator-min-microvolt = "", "\f5";
						regulator-max-microvolt = <0x895440>;
						regulator-allow-set-load;
						qcom,swire-control;
						phandle = <0xce>;
					};

					elvdd@f900 {
						reg = <0xf900>;
						reg-names = "ab_base";
						regulator-name = "ab";
						regulator-min-microvolt = <0x2625a0>;
						regulator-max-microvolt = <0x53ec60>;
						qcom,swire-control;
						phandle = <0xcf>;
					};

					oledb@fa00 {
						reg = <0xfa00>;
						reg-names = "oledb_base";
						regulator-name = "oledb";
						regulator-min-microvolt = <0x4c4b40>;
						regulator-max-microvolt = <0x7a1200>;
						qcom,swire-control;
						phandle = <0xd0>;
					};
				};
			};

			qcom,pmih010x@7 {
				compatible = "qcom,spmi-pmic";
				reg = <0x07 0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				pmic-ecid@100 {
					compatible = "qcom,pmic-ecid";
					reg = <0x100>;
					qcom,pmic-name = "pmih010x";
				};

				pmih010x-temp-alarm@a00 {
