					};

					svooc_mos_btb_therm {

						svooc_mos_btb_therm_default {
							pins = "gpio15";
							function = "normal";
							bias-high-impedance;
							bias-disable;
							phandle = <0x01>;
						};
					};

					rx_en_sleep {
						pins = "gpio2";
						function = "normal";
						input-disable;
						bias-disable;
