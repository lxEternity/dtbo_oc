	fragment@105 {
		phandle = <0x172>;
		target = <0xffffffff>;

		__overlay__ {

			qcom,camera-flash1 {
				phandle = <0x15c>;
				status = "ok";
				leds = <0xb8>;
				compatible = "qcom,camera-flash";
				cell-index = <0x00>;
			};

			qcom,camera-flash3 {
				phandle = <0x164>;
				status = "ok";
				leds = <0xb8>;
				compatible = "qcom,camera-flash";
				cell-index = <0x02>;
			};

			qcom,cam-res-mgr {
				status = "ok";
				compatible = "qcom,cam-res-mgr";
			};

			oplus,camera_extension@0 {
				status = "ok";
				enable_camera_extension;
				compatible = "oplus,camera_extension";
			};
		};
	};

	fragment@107 {
		phandle = <0x173>;
		target = <0xffffffff>;

		__overlay__ {

			cam_sensor_main_mclk1_active {
				phandle = <0x15d>;

				mux {
					function = "cam_mclk";
					pins = "gpio90";
				};

				config {
					drive-strength = <0x02>;
					bias-disable;
					pins = "gpio90";
				};
			};

			cam_sensor_main_mclk1_suspend {
				phandle = <0x15f>;

				mux {
					function = "cam_mclk";
					pins = "gpio90";
				};

				config {
					drive-strength = <0x02>;
					bias-pull-down;
					pins = "gpio90";
				};
			};

			cam_sensor_front_mclk4_active {
				phandle = <0x169>;

				mux {
					function = "cam_asc_mclk4";
					pins = "gpio93";
				};

				config {
					drive-strength = <0x02>;
					bias-disable;
					pins = "gpio93";
				};
			};

			cam_sensor_front_mclk4_suspend {
				phandle = <0x16d>;

				mux {
					function = "cam_asc_mclk4";
					pins = "gpio93";
				};

				config {
					drive-strength = <0x02>;
					bias-pull-down;
					pins = "gpio93";
				};
			};

			cam_sensor_front_active_rst4 {
				phandle = <0x16a>;

				mux {
					function = "gpio";
					pins = "gpio7";
				};

				config {
					qcom,apps;
					output-high;
					drive-strength = <0x02>;
					bias-pull-up;
					pins = "gpio7";
				};
			};

			cam_sensor_front_suspend_rst4 {
				phandle = <0x16e>;

				mux {
					function = "gpio";
					pins = "gpio7";
				};

				config {
					qcom,remote;
					output-low;
					drive-strength = <0x02>;
					bias-pull-down;
					pins = "gpio7";
				};
			};

			cam_sensor_front_ponv_active {
				phandle = <0x16b>;

				mux {
					function = "gpio";
					pins = "gpio6";
				};

				config {
					drive-strength = <0x06>;
					output-high;
					bias-pull-up;
					pins = "gpio6";
				};
			};

			cam_sensor_front_ponv_suspend {
				phandle = <0x16f>;

				mux {
					function = "gpio";
					pins = "gpio6";
				};

				config {
					drive-strength = <0x06>;
					output-low;
					bias-pull-down;
					pins = "gpio6";
				};
			};

			cam_sensor_front_irq_active {
				phandle = <0x16c>;

				mux {
					function = "gpio";
					pins = "gpio96";
				};

				config {
					drive-strength = <0x06>;
					output-high;
					bias-pull-up;
					pins = "gpio96";
				};
			};

			cam_sensor_front_irq_suspend {
				phandle = <0x170>;

				mux {
					function = "gpio";
					pins = "gpio96";
				};

				config {
					drive-strength = <0x06>;
					output-low;
					bias-pull-down;
					pins = "gpio96";
				};
			};
		};
	};

