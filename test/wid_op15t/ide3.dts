	fragment@13 {
		target = <0xffffffff>;

		__overlay__ {
			usb-role-switch;
			qcom,wcd_usbss = <0xffffffff>;

			port {

				endpoint {
					remote-endpoint = <0x3a>;
					phandle = <0x3b>;
				};
			};
		};
	};

	fragment@14 {
		target = <0xffffffff>;

		__overlay__ {

			connector {
				compatible = "usb-c-connector";

				ports {
					#address-cells = <0x01>;
					#size-cells = <0x00>;

					port@0 {
						reg = <0x00>;

						endpoint {
							remote-endpoint = <0x3b>;
							phandle = <0x3a>;
						};
					};

					port@1 {
						reg = <0x01>;

						endpoint {
							remote-endpoint = <0x3c>;
							phandle = <0x39>;
						};
					};
				};
			};
		};
	};

	fragment@15 {
		target = <0xffffffff>;

		__overlay__ {

			i2c@104 {
				reg = <0x104>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				qcom,bus-type = "i2c";

				smb1501@68 {
					compatible = "qcom,i2c-pmic";
					reg = <0x68>;
					qcom,can-sleep;
				};

				smb1501@69 {
					compatible = "qcom,i2c-pmic";
					reg = <0x69>;
					qcom,can-sleep;
