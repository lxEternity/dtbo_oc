					qcom,brake-sig-shape = <0x01>;
					qcom,rt-imp-detect;
					nvmem-names = "hap_cfg_sdam";
					nvmem = <0x0f>;
					qcom,cl-vmax-mv = <0x4ec>;
					qcom,cl_lra-period-us = <0x15f2>;
					qcom,fifo-vmax-mv = <0x1d1a>;
					qcom,old-steady-vmax-mv = <0x1d1a>;
					qcom,cal-data-restore;
					qcom,fifo-empty-threshold = <0x1e0>;
					qcom,vibrator-type = <0x329>;
					qcom,vbat-low-soc = <0x05>;
					qcom,vbat-low-soc-cold = <0x14>;
					qcom,vbat-low-temp = <0xffffffce>;
					qcom,vbat-low-fifo-vmax-mv = <0x1a90>;
