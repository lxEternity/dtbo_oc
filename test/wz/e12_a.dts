				phandle = <0x04>;

				pins-cmd-dat {
					pinmux = <0x7600>;
					slew-rate = <0x01>;
					output-low;
				};
			};

			lcm-rst-out1-gpio {
				phandle = <0x05>;

				pins-cmd-dat {
					pinmux = <0x5900>;
					slew-rate = <0x01>;
