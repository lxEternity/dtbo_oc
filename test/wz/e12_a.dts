		__overlay__ {

			pins_default {
				phandle = <0xd0>;
			};

			int1_active {
				phandle = <0xd1>;

				pins_cmd_dat {
					pinmux = <0x400>;
					bias-disable;
					input-enable;
				};
			};

			reset1_active {
				phandle = <0xd2>;

				pins_cmd_dat {
					pinmux = <0x300>;
					output-high;
				};
			};

			int1_suspend {
				phandle = <0xd3>;

				pins_cmd_dat {
					pinmux = <0x400>;
					output-low;
				};
			};

			reset1_suspend {
				phandle = <0xd4>;

				pins_cmd_dat {
					pinmux = <0x300>;
					output-low;
				};
			};

			spi_active {
				phandle = <0xd5>;

				pins_cmd_dat {
					pinmux = <0x5002 0x5102 0x5202 0x5302>;
					bias-disable;
					drive-strength = <0x02>;
				};
			};

			spi_suspend {
				phandle = <0xd6>;

				pins_cmd_dat {
					pinmux = <0x5000 0x5300 0x5200 0x5100>;
					bias-disable;
					output-low;
					drive-strength = <0x04>;
				};
			};
		};
	};

