				pins_cmd_dat {
					pinmux = <0x1d00>;
					input-enable;
					bias-pull-up;
				};
			};

			i2c5_mode_default {
				phandle = <0xd9>;

				pins_cmd_dat {
					pinmux = <0xb201 0xb301>;
					bias-pull-up = <0xcf>;
				};
			};
		};
	};

